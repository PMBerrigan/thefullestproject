{# Email signup. Posts to the tfp-admin-api worker with a Formspree fallback so
   it keeps working without JavaScript. #}
<section class="{{ [padClass, bgClass] | join(' ') | trim }}" data-block-id="{{ blockId }}" data-block-type="newsletter" data-block-index="{{ blockIndex }}">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
    <h2 class="text-3xl font-bold mb-4" style="font-family: var(--font-heading);" data-block-field="heading">{{ block.heading }}</h2>
    <p class="mb-8 opacity-90" data-block-field="body">{{ block.body }}</p>
    <form action="https://formspree.io/f/{{ site.formspree.newsletter }}" method="POST" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
      data-newsletter data-worker-url="{{ site.adminWorkerUrl }}/newsletter">
      <label for="newsletter-email-{{ blockIndex }}" class="sr-only">Email address</label>
      <input type="email" id="newsletter-email-{{ blockIndex }}" name="email" placeholder="{{ block.placeholder }}" required
        class="form-input flex-grow" style="background-color: white; color: var(--color-text);">
      <button type="submit" class="btn-secondary whitespace-nowrap" data-block-field="buttonLabel">{{ block.buttonLabel }}</button>
    </form>
  </div>
</section>
