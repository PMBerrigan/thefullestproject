{# People cards — name, where they are, two paragraphs of biography and a bold
   closing line. Used for the founders on the About page. #}
<section class="{{ [padClass, bgClass] | join(' ') | trim }}" data-block-id="{{ blockId }}" data-block-type="profiles" data-block-index="{{ blockIndex }}">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center mb-12" style="color: var(--color-primary);" data-block-field="heading">{{ block.heading }}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      {% for person in block.people %}
      <div class="card p-8">
        <h3 class="text-2xl font-bold mb-2" style="color: var(--color-primary);" data-block-field="people.{{ loop.index0 }}.name">{{ person.name }}</h3>
        <p class="text-sm font-semibold mb-4" style="color: var(--color-secondary);" data-block-field="people.{{ loop.index0 }}.location">{{ person.location }}</p>
        <p class="mb-4" style="color: var(--color-text-light);" data-block-field="people.{{ loop.index0 }}.paragraph1">
          {{ person.paragraph1 }}
        </p>
        <p class="mb-4" style="color: var(--color-text-light);" data-block-field="people.{{ loop.index0 }}.paragraph2">
          {{ person.paragraph2 }}
        </p>
        <p class="text-sm font-semibold" style="color: var(--color-primary);" data-block-field="people.{{ loop.index0 }}.highlight">
          {{ person.highlight }}
        </p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
