{#
  App card. Expects in context:
    app          — a directory entry with format: "app"
    appFunction  — the apps-* slug of the group being rendered (for the filter)

  Data attributes are the contract with src/js/appFilter.js — keep them in sync.
#}
<article class="card p-6 app-card"
         data-name="{{ app.name | lower }}"
         data-description="{{ app.description | lower }}"
         data-function="{{ appFunction | default('') }}"
         data-platforms="{{ app.platforms | default([]) | join(',') }}"
         data-pricing="{{ app.pricing | default('') }}">

  <div class="flex items-start justify-between gap-2 mb-3">
    <h3 class="text-lg font-bold" style="color: var(--color-primary);">{{ app.name }}</h3>
    <span class="tag shrink-0" style="background-color: var(--color-accent); color: white;">App</span>
  </div>

  {% if app.description %}
  <p class="text-sm mb-4" style="color: var(--color-text-light);">{{ app.description }}</p>
  {% endif %}

  {% if app.platforms and app.platforms.length %}
  <p class="sr-only">Available on {% for p in app.platforms %}{{ appTaxonomy.platforms[p] | default(p) }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
  <ul class="flex flex-wrap gap-2 mb-3 list-none p-0 m-0" aria-hidden="true">
    {% for p in app.platforms %}
    <li><span class="tag" style="background-color: var(--color-warm); color: var(--color-primary);">{{ appTaxonomy.platforms[p] | default(p) }}</span></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if app.pricing %}
  <p class="text-xs mb-4" style="color: var(--color-text-light);">
    <span class="font-semibold">{{ appTaxonomy.pricing[app.pricing] | default(app.pricing) }}</span>{% if app.cost %} &middot; {{ app.cost }}{% endif %}
  </p>
  {% endif %}

  {% if app.appStore or app.playStore %}
  <div class="flex flex-wrap gap-2 mb-3">
    {% if app.appStore %}
    <a href="{{ app.appStore }}" target="_blank" rel="noopener noreferrer"
       class="text-xs font-semibold no-underline px-3 py-1.5 rounded-md border-2"
       style="border-color: var(--color-primary); color: var(--color-primary);"
       aria-label="Get {{ app.name }} on the App Store">App Store</a>
    {% endif %}
    {% if app.playStore %}
    <a href="{{ app.playStore }}" target="_blank" rel="noopener noreferrer"
       class="text-xs font-semibold no-underline px-3 py-1.5 rounded-md border-2"
       style="border-color: var(--color-primary); color: var(--color-primary);"
       aria-label="Get {{ app.name }} on Google Play">Google Play</a>
    {% endif %}
  </div>
  {% endif %}

  {% if app.website %}
  <a href="{{ app.website }}" target="_blank" rel="noopener noreferrer"
     class="text-sm font-semibold no-underline inline-block"
     style="color: var(--color-secondary);"
     aria-label="Visit the {{ app.name }} website">Visit Website &rarr;</a>
  {% endif %}
</article>
