---
layout: layouts/base.njk
title: Podcast
description: "Listen to conversations with families, professionals, and advocates making a difference in the disability community."
permalink: /podcast/
---

<section class="py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold mb-4 text-center" style="color: var(--color-primary);">The Fullest Project Podcast</h1>
    <p class="text-center mb-8" style="color: var(--color-text-light);">
      Conversations with families, professionals, and advocates making a difference in the disability community.
    </p>

    <!-- Listen On -->
    <div class="flex justify-center gap-4 mb-12">
      <span class="text-sm font-semibold px-4 py-2 rounded-full" style="background-color: var(--color-warm); color: var(--color-text-light);">Coming to Spotify</span>
      <span class="text-sm font-semibold px-4 py-2 rounded-full" style="background-color: var(--color-warm); color: var(--color-text-light);">Coming to Apple Podcasts</span>
    </div>

    <!-- Episodes -->
    <div class="space-y-8">
      {% for episode in collections.podcastEpisodes %}
      <article class="card p-8">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 rounded-lg flex items-center justify-center font-bold text-white" style="background-color: var(--color-primary);">
            {{ episode.data.episodeNumber or loop.index }}
          </div>
          <div class="flex-grow">
            <h2 class="text-xl font-bold mb-2">
              <a href="{{ episode.url }}" class="no-underline" style="color: var(--color-primary);">{{ episode.data.title }}</a>
            </h2>
            <p class="text-sm mb-3" style="color: var(--color-text-light);">{{ episode.data.excerpt }}</p>
            <div class="flex items-center gap-4 text-xs" style="color: var(--color-text-light);">
              <time datetime="{{ episode.date | dateFormat }}">{{ episode.date | dateFormat }}</time>
              {% if episode.data.duration %}
              <span>{{ episode.data.duration }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      </article>
      {% else %}
      <div class="card p-8 text-center">
        <p class="text-lg mb-4" style="color: var(--color-text-light);">Episodes coming soon!</p>
        <p style="color: var(--color-text-light);">We're recording conversations with amazing families and professionals. Sign up for our newsletter to be notified when our first episode drops.</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Featured Disability & Accessibility Podcasts -->
{% if featuredPodcasts.length > 0 %}
<section class="py-16 section-warm">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center mb-4" style="color: var(--color-primary);">Podcasts We Love</h2>
    <p class="text-center mb-8" style="color: var(--color-text-light);">
      While we get our podcast off the ground, here are {{ featuredPodcasts.length }} podcasts from the disability and caregiving community — hosted by parents, caregivers, and disabled adults who have been where you are.
    </p>

    {# With this many shows, browsing the whole list is not realistic — filter first. #}
    <div class="card p-4 mb-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="podcast-search" class="block text-sm font-semibold mb-2">Search</label>
          <input type="text" id="podcast-search" placeholder="Search by name or topic..." class="form-input">
        </div>
        <div>
          <label for="podcast-category" class="block text-sm font-semibold mb-2">Topic</label>
          <select id="podcast-category" class="filter-select">
            <option value="">All Topics</option>
            {% set cats = featuredPodcasts | pluck('category') | unique | sort %}
            {% for c in cats %}
            <option value="{{ c }}">{{ c }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <p id="podcast-results-count" class="text-sm mt-3" style="color: var(--color-text-light);" aria-live="polite"></p>
    </div>

    <div id="podcast-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {% for podcast in featuredPodcasts %}
      <article class="card p-6 podcast-card"
               data-name="{{ podcast.name | lower }}"
               data-description="{{ podcast.description | lower }}"
               data-hosts="{{ podcast.hosts | lower }}"
               data-category="{{ podcast.category }}">
        <span class="tag" style="background-color: var(--color-warm); color: var(--color-primary);">{{ podcast.category }}</span>
        <h3 class="text-lg font-bold mt-3 mb-1" style="color: var(--color-text);">{{ podcast.name }}</h3>
        {% if podcast.hosts %}
        <p class="text-xs mb-2" style="color: var(--color-accent);">Hosted by {{ podcast.hosts }}</p>
        {% endif %}
        <p class="text-sm mb-4" style="color: var(--color-text-light);">{{ podcast.description }}</p>
        <div class="flex gap-2 flex-wrap">
          {% if podcast.listenUrl %}
          <a href="{{ podcast.listenUrl }}" target="_blank" rel="noopener noreferrer"
             class="btn-primary text-xs no-underline">Listen Now</a>
          {% endif %}
          {% if podcast.website and podcast.website != podcast.listenUrl %}
          <a href="{{ podcast.website }}" target="_blank" rel="noopener noreferrer"
             class="btn-secondary text-xs no-underline">Website</a>
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>

    <div id="podcast-no-results" class="card p-8 text-center" hidden>
      <p style="color: var(--color-text-light);">No podcasts match that search. Try a different word or topic.</p>
    </div>
  </div>
</section>

<script src="/js/podcastFilter.js"></script>
{% endif %}
